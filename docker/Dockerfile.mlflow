FROM python:3.11-slim

RUN groupadd -r finsight && useradd -r -g finsight -d /app -s /sbin/nologin finsight

WORKDIR /app

RUN pip install --no-cache-dir mlflow psycopg2-binary boto3

RUN mkdir -p /app/mlflow && chown -R finsight:finsight /app

USER finsight

EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000"]
