# FinSight — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────
ENV=dev
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finsight
DB_USER=finsight_user
DB_PASSWORD=your_password_here

# ── Airflow ───────────────────────────────────────────────
AIRFLOW_PASSWORD=your_airflow_password_here

# ── FastAPI Auth ──────────────────────────────────────────
# Format: key1:role1,key2:role2 (comma-separated)
# Roles: admin, enterprise, dashboard
API_KEYS_DEV=your_dev_key_here:admin
API_KEYS_PROD=your_prod_key_here:enterprise,your_dashboard_key_here:dashboard
FINSIGHT_API_KEY=your_dev_key_here
FINSIGHT_ENV=dev

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MLflow ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# Streamlit business dashboards (optional; falls back to demo data when unset)
WAREHOUSE_URL=postgresql+psycopg2://finsight_user:CHANGE_ME@localhost:5432/finsight
