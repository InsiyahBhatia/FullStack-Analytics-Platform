# FinSight — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────
ENV=dev
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finsight
DB_USER=finsight_user
DB_PASSWORD=your_password_here

# ── Airflow ───────────────────────────────────────────────
AIRFLOW_PASSWORD=your_airflow_password_here

# ── FastAPI Auth ──────────────────────────────────────────
# Format: key1:role1,key2:role2 (comma-separated)
# Roles: admin, enterprise, dashboard
API_KEYS_DEV=sk-test-finsight-xxxx:admin
API_KEYS_PROD=sk-live-finsight-a1b2c3d4:enterprise,sk-live-finsight-e5f6g7h8:dashboard
FINSIGHT_ENV=dev

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MLflow ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
