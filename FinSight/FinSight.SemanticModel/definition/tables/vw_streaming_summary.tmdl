table vw_streaming_summary
	lineageTag: vwss-001

	measure LatestMinuteTxnCount =
			CALCULATE(
				MAX(vw_streaming_summary[total_transactions]),
				TOPN(1, ALL(vw_streaming_summary), vw_streaming_summary[minute_bucket], DESC)
			)
			formatString: #,##0
			displayFolder: Summary Measures
			lineageTag: vwss-m-001
		lineageTag: 6c0aa96a-3e0f-4e1e-b49c-a48fa3e57b30

	measure LatestMinuteFraud =
			CALCULATE(
				MAX(vw_streaming_summary[fraud_count]),
				TOPN(1, ALL(vw_streaming_summary), vw_streaming_summary[minute_bucket], DESC)
			)
			formatString: #,##0
			displayFolder: Summary Measures
			lineageTag: vwss-m-002
		lineageTag: 77250ca4-922e-4693-947d-51a9736066a0

	column minute_bucket
		dataType: dateTime
		formatString: General Date
		lineageTag: vwss-002
		summarizeBy: none
		sourceColumn: minute_bucket

	column total_transactions
		dataType: int64
		formatString: #,##0
		lineageTag: vwss-003
		summarizeBy: sum
		sourceColumn: total_transactions

	column fraud_count
		dataType: int64
		formatString: #,##0
		lineageTag: vwss-004
		summarizeBy: sum
		sourceColumn: fraud_count

	column avg_amount
		dataType: double
		formatString: $#,##0.00
		lineageTag: vwss-005
		summarizeBy: none
		sourceColumn: avg_amount

	column total_amount
		dataType: double
		formatString: $#,##0.00
		lineageTag: vwss-006
		summarizeBy: sum
		sourceColumn: total_amount

	partition vw_streaming_summary = m
		mode: import
		source = PostgreSQL.Database("localhost:5433", "finsight"){[Schema="public",Item="vw_streaming_summary"]}[Data]

