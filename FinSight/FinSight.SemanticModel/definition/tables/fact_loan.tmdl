table fact_loan
	lineageTag: fl-001

	measure TotalLoans = COUNT(fact_loan[loan_id_orig])
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: fl-m-001

	measure DefaultCount = CALCULATE(COUNTROWS(fact_loan), fact_loan[default_flag] = 1)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: fl-m-002

	measure DefaultRate = DIVIDE([DefaultCount], [TotalLoans], 0)
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: fl-m-003

	measure AvgInterestRate = AVERAGE(fact_loan[interest_rate])
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: fl-m-004

	measure AvgLoanAmount = AVERAGE(fact_loan[loan_amount])
		formatString: $#,##0
		displayFolder: KPIs
		lineageTag: fl-m-005

	measure LoanVolume = SUM(fact_loan[loan_amount])
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: fl-m-006

	measure RiskExposure = CALCULATE(SUM(fact_loan[loan_amount]), fact_loan[default_flag] = 1)
		formatString: $#,##0.00
		displayFolder: Advanced
		lineageTag: fl-m-007

	measure ApprovalRate = 1 - [DefaultRate]
		formatString: 0.00%
		displayFolder: Advanced
		lineageTag: fl-m-008

	measure AvgDTI = AVERAGE(fact_loan[dti])
		formatString: 0.00
		displayFolder: Advanced
		lineageTag: fl-m-009

	measure HighRiskLoanRate = CALCULATE(COUNTROWS(fact_loan), fact_loan[default_flag] = 1) / COUNTROWS(fact_loan)
		formatString: 0.00%
		displayFolder: Advanced
		lineageTag: fl-m-010

