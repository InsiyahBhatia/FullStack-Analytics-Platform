	partition fact_churn = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "finsight"),
					fact_churn = Source{[Schema="public",Item="fact_churn"]}[Data],
					#"Added Sort" = Table.AddColumn(fact_churn, "tenure_group_sort", each if [tenure_group] = "0-6 months" then 1 else if [tenure_group] = "6-12 months" then 2 else if [tenure_group] = "12-24 months" then 3 else if [tenure_group] = "24-48 months" then 4 else if [tenure_group] = "48+ months" then 5 else 99, Int64.Type)
				in
					#"Added Sort"

