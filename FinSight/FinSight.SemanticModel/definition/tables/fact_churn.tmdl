table fact_churn
	lineageTag: fc-001

	measure TotalCustomers = COUNT(fact_churn[customer_id])
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: fc-m-001

	measure ChurnedCustomers = CALCULATE(COUNTROWS(fact_churn), fact_churn[churn_flag] = 1)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: fc-m-002

	measure ChurnRate = DIVIDE(SUM(fact_churn[churn_flag]), COUNT(fact_churn[customer_id]), 0)
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: fc-m-003

	measure AvgMonthlyCharges = AVERAGE(fact_churn[monthly_charges])
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: fc-m-004

	measure AvgTenure = AVERAGE(fact_churn[tenure])
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: fc-m-005

	measure CustomerLifetimeValue = AVERAGE(fact_churn[monthly_charges]) * AVERAGE(fact_churn[tenure])
		formatString: $#,##0.00
		displayFolder: Advanced
		lineageTag: fc-m-006

	measure RetentionRate = 1 - [ChurnRate]
		formatString: 0.00%
		displayFolder: Advanced
		lineageTag: fc-m-007

	measure RevenueAtRisk = [ChurnedCustomers] * [AvgMonthlyCharges] * [AvgTenure]
		formatString: $#,##0.00
		displayFolder: Advanced
		lineageTag: fc-m-008

	measure ChurnImpactPct = DIVIDE([RevenueAtRisk], [CustomerLifetimeValue] * [TotalCustomers], 0)
		formatString: 0.00%
		displayFolder: Advanced
		lineageTag: fc-m-009

	measure TotalRevenue = SUM(fact_churn[total_charges])
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: fc-m-010

	column churn_id
		dataType: int64
