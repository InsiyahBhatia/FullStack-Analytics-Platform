table Dim_ColorPalette
	lineageTag: dim-color-palette

	column Index
		dataType: int64
		lineageTag: dcp-index
		summarizeBy: none
		isNameInferred
		sourceColumn: [Index]

	column HexCode
		dataType: string
		lineageTag: dcp-hex
		summarizeBy: none
		isNameInferred
		sourceColumn: [HexCode]

	partition Dim_ColorPalette = calculated
		mode: import
		source =
				DATATABLE (
					"Index", INTEGER,
					"HexCode", STRING,
