		lineageTag: e0f8ba79-1634-4d56-a0bb-345b788aebb4
		isNameInferred
		sourceColumn: [IsHoliday]

	partition Dim_Date = calculated
		source =
				ADDCOLUMNS(
					CALENDAR(DATE(2020, 1, 1), DATE(2030, 12, 31)),
					"Year", YEAR([Date]),
					"Quarter", QUARTER([Date]),
					"Month", MONTH([Date]),
					"MonthName", FORMAT([Date], "MMMM"),
					"Day", DAY([Date]),
					"Weekday", FORMAT([Date], "DDDD"),
					"WeekOfYear", WEEKNUM([Date], 2),
					"YearQuarter", YEAR([Date]) & " Q" & QUARTER([Date]),
					"YearMonth", YEAR([Date]) & "-" & FORMAT(MONTH([Date]), "00"),
					"IsWeekend", WEEKDAY([Date], 2) >= 6,
					"IsHoliday", FALSE
				)

