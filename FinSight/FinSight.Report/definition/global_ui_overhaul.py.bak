import json
import os
import glob
import shutil

pages_dir = r"d:\FinSight\FinSight\FinSight.Report\definition\pages"

# Define the global elements
header_bg_json = {
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.10.0/schema.json",
  "name": "header_bg",
  "position": { "x": 0, "y": 0, "z": 0, "height": 80, "width": 1280, "tabOrder": 0 },
  "visual": {
    "visualType": "shape",
    "objects": {
      "fill": [ { "properties": { "fillColor": { "solid": { "color": { "expr": { "Literal": { "Value": "'#1A365D'" } } } } }, "transparency": { "expr": { "Literal": { "Value": "0D" } } } } } ],
      "shape": [ { "properties": { "tileShape": { "expr": { "Literal": { "Value": "'rectangle'" } } } } } ]
    }
  }
}

nav_bar_json = {
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.10.0/schema.json",
  "name": "global_nav_bar",
  "position": { "x": 500, "y": 20, "z": 1000, "height": 40, "width": 760, "tabOrder": 1000 },
  "visual": {
    "visualType": "pageNavigator"
  }
}

# Define a palette
palette = ["'#2B6CB0'", "'#3182CE'", "'#4299E1'", "'#63B3ED'", "'#90CDF4'", "'#E2E8F0'"]

def format_title(page_name):
    return page_name.replace('_', ' ').title()

# Iterate over pages
pages = glob.glob(os.path.join(pages_dir, "*", "page.json"))

for page_file in pages:
    page_folder = os.path.dirname(page_file)
    page_name = os.path.basename(page_folder)
    
    # 1. Update page height
    with open(page_file, 'r', encoding='utf-8') as f:
        page_data = json.load(f)
    page_data["height"] = 800
    with open(page_file, 'w', encoding='utf-8') as f:
        json.dump(page_data, f, indent=2)
        
    # 2. Process visuals (shift and color)
    visual_files = glob.glob(os.path.join(page_folder, "visuals", "*", "visual.json"))
    color_index = 0
    for vf in visual_files:
        with open(vf, 'r', encoding='utf-8') as f:
            v_data = json.load(f)
            
        # Shift down
        v_data["position"]["y"] = v_data["position"].get("y", 0) + 80
        
        # Inject color scheme for charts
        vt = v_data.get("visual", {}).get("visualType", "")
        if vt in ["barChart", "columnChart", "donutChart", "pieChart"]:
            if "objects" not in v_data["visual"]:
                v_data["visual"]["objects"] = {}
            v_data["visual"]["objects"]["dataPoint"] = [
                {
                    "properties": {
                        "fill": {
                            "solid": {
                                "color": {
                                    "expr": {
                                        "Literal": {
                                            "Value": palette[color_index % len(palette)]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
            color_index += 1
            
        with open(vf, 'w', encoding='utf-8') as f:
            json.dump(v_data, f, indent=2)

    # 3. Create header and nav
    header_dir = os.path.join(page_folder, "visuals", "header_bg")
    nav_dir = os.path.join(page_folder, "visuals", "global_nav_bar")
    
    os.makedirs(header_dir, exist_ok=True)
    os.makedirs(nav_dir, exist_ok=True)
    
    # Add the text property to the header background dynamically
    page_header_json = json.loads(json.dumps(header_bg_json))
    page_header_json["visual"]["objects"]["text"] = [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": f"'{format_title(page_name)}'" } } },
            "fontColor": { "solid": { "color": { "expr": { "Literal": { "Value": "'#FFFFFF'" } } } } },
            "fontSize": { "expr": { "Literal": { "Value": "24D" } } },
            "alignment": { "expr": { "Literal": { "Value": "'left'" } } }
          }
        }
    ]
    
    with open(os.path.join(header_dir, "visual.json"), 'w', encoding='utf-8') as f:
        json.dump(page_header_json, f, indent=2)
        
    with open(os.path.join(nav_dir, "visual.json"), 'w', encoding='utf-8') as f:
        json.dump(nav_bar_json, f, indent=2)

print("Global overhaul applied successfully.")
