import json
import os
import glob

pages_dir = r"d:\FinSight\FinSight\FinSight.Report\definition\pages"

# 1. Clean page backgrounds
page_files = glob.glob(os.path.join(pages_dir, "*", "page.json"))

for page_file in page_files:
    with open(page_file, 'r', encoding='utf-8') as f:
        page_data = json.load(f)
        
    if "objects" in page_data:
        page_data["objects"].pop("background", None)
        page_data["objects"].pop("outspace", None)
        if not page_data["objects"]:
            del page_data["objects"]
            
    with open(page_file, 'w', encoding='utf-8') as f:
        json.dump(page_data, f, indent=2)

# 2. Clean visual backgrounds and data points
visual_files = glob.glob(os.path.join(pages_dir, "*", "visuals", "*", "visual.json"))

for vf in visual_files:
    if "header_bg" in vf or "global_nav_bar" in vf:
        continue # Leave the header and nav alone

    with open(vf, 'r', encoding='utf-8') as f:
        v_data = json.load(f)
        
    modified = False
    
    # Remove background from visualContainerObjects
    vco = v_data.get("visual", {}).get("visualContainerObjects", {})
    if "background" in vco:
        del vco["background"]
        modified = True
        
    # Remove dataPoint colors
    objs = v_data.get("visual", {}).get("objects", {})
    if "dataPoint" in objs:
        del objs["dataPoint"]
        modified = True
        
    if modified:
        with open(vf, 'w', encoding='utf-8') as f:
            json.dump(v_data, f, indent=2)

print("Hardcoded colors removed successfully.")
